<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
            <h1 class="text-center">Cadastro</h1>
            <p class="text-center lead">Crie sua conta abaixo</p>

            <div class="container d-flex justify-content-center align-items-center">
                <div class="card shadow p-4" style="width: 500px;">
                    <div class="row ">
                        <div class="col-lg">
                        <div class="text-center">
                            <h4>Faça seu cadastro</h4>
                            <p>Se voçê não tem conta, preencha o formualario abaixo:</p>

                            <%- include('includes/messages.ejs') %>

                        </div>
                        <form class="form-cadastro" action="/cadastro/register" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="mb-3">
                                <label for="exampleInputEmail1" class="form-label">Seu E-mail</label>
                                <input type="email" class="form-control" name="email" aria-describedby="emailHelp">
                                <div class="invalid-feedback">Digite um e-mail valido.</div>
                            </div>
                            <div class="mb-3">
                                <label for="exampleInputEmail1" class="form-label">Sua Senha</label>
                                <input type="password" class="form-control" name="password" aria-describedby="emailHelp">
                                <div class="invalid-feedback">Senha precisa ter entre 8 e 50 caracteres.</div>
                            </div>

                            <div class="d-flex flex-column flex-sm-row align-items-center gap-2">
                                <button type="submit" class="btn btn-primary px-4">
                                    Criar minha conta
                                </button>

                                <div class="d-flex align-items-center gap-2 ms-sm-auto">
                                    <span>Já tem conta?</span>
                                    <a href="/login" class="btn btn-primary ms-2">Login</a>
                                </div>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>
            </div>

            

        </div>

        <div class="col-lg-2"></div>
    </div>
</div>

<%- include('includes/footer.ejs') %>
